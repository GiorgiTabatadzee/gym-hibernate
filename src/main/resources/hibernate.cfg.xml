<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>

        <!--
          Chosen DBMS: H2, file-based (data survives restarts, zero external setup).
          File is created at ./data/gymdb in the working directory.

          To switch to PostgreSQL instead:
            1) start a Postgres instance and create a database, e.g. `gymdb`
            2) replace the four properties below with:
                 <property name="hibernate.connection.driver_class">org.postgresql.Driver</property>
                 <property name="hibernate.connection.url">jdbc:postgresql://localhost:5432/gymdb</property>
                 <property name="hibernate.connection.username">postgres</property>
                 <property name="hibernate.connection.password">postgres</property>
            3) change hibernate.dialect to org.hibernate.dialect.PostgreSQLDialect
          (the postgresql driver jar is already on the classpath via pom.xml)
        -->
        <property name="hibernate.connection.driver_class">org.h2.Driver</property>
        <property name="hibernate.connection.url">jdbc:h2:file:./data/gymdb;AUTO_SERVER=TRUE</property>
        <property name="hibernate.connection.username">sa</property>
        <property name="hibernate.connection.password"></property>
        <property name="hibernate.dialect">org.hibernate.dialect.H2Dialect</property>

        <property name="hibernate.hbm2ddl.auto">update</property>
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>
        <property name="hibernate.connection.pool_size">5</property>
        <property name="hibernate.current_session_context_class">thread</property>

        <mapping class="com.epam.gym.entity.User"/>
        <mapping class="com.epam.gym.entity.Trainee"/>
        <mapping class="com.epam.gym.entity.Trainer"/>
        <mapping class="com.epam.gym.entity.Training"/>
        <mapping class="com.epam.gym.entity.TrainingType"/>

    </session-factory>
</hibernate-configuration>
